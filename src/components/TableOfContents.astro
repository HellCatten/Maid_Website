---
export interface TocItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: TocItem[];
  title?: string;
  rootSelector?: string;
}

const {
  headings = [],
  title = "Содержание",
  rootSelector = ".wiki-content",
} = Astro.props;

// Оставляем только h2 заголовки, если данные передаются через props
const filteredHeadings = headings.filter((item) => item.depth === 2);
---

<nav class="wiki-toc" aria-label={title}>
  <div class="toc-header">
    <span class="toc-title">{title}</span>
  </div>
  <div class="toc-body">
    {filteredHeadings.length > 0 ? (
      <ol class="toc-list">
        {filteredHeadings.map((item, index) => (
          <li class="toc-item">
            <a href={`#${item.slug}`}>
              <span class="toc-num">{index + 1}. </span>
              <span>{item.text}</span>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <ol class="toc-list" data-auto-toc data-root={rootSelector}></ol>
    )}
  </div>
</nav>

<script>
  function initAutoToc() {
    const tocLists = document.querySelectorAll<HTMLOListElement>('[data-auto-toc]');
    
    tocLists.forEach((list) => {
      const rootSel = list.getAttribute('data-root') || '.wiki-content';
      const root = document.querySelector(rootSel);
      if (!root) return;

      // Ищем только H2
      const headings = root.querySelectorAll<HTMLHeadingElement>('h2');
      if (headings.length === 0) {
        list.closest('.wiki-toc')?.remove();
        return;
      }

      list.innerHTML = '';
      let h2Counter = 0;

      headings.forEach((heading) => {
        if (!heading.id) {
          const rawText = heading.textContent || '';
          heading.id = rawText
            .toLowerCase()
            .trim()
            .replace(/[^\w\u0400-\u04FF\s-]/g, '')
            .replace(/\s+/g, '-');
        }

        h2Counter++;

        const li = document.createElement('li');
        li.className = 'toc-item';

        const a = document.createElement('a');
        a.href = `#${heading.id}`;
        
        const numSpan = document.createElement('span');
        numSpan.className = 'toc-num';
        numSpan.textContent = `${h2Counter}. `;

        const textSpan = document.createElement('span');
        textSpan.textContent = heading.textContent || '';

        a.appendChild(numSpan);
        a.appendChild(textSpan);
        li.appendChild(a);
        list.appendChild(li);
      });
    });
  }

  initAutoToc();
  document.addEventListener('astro:page-load', initAutoToc);
</script>

<style>
  .wiki-toc {
    display: block;
    width: 100%;
    max-width: 480px;
    box-sizing: border-box;
    padding: 0.85rem 1.25rem;
    background: rgba(18, 18, 22, 0.7);
    border: 1px solid rgba(253, 248, 201, 0.15);
    border-left: 3px solid var(--accent-color-bg, #ff5900);
    border-radius: 8px;
    font-size: 0.92rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  }

  .toc-header {
    display: flex;
    align-items: center;
    color: var(--accent-color, rgb(253, 248, 201));
    user-select: none;
  }

  .toc-title {
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }

  .toc-body {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(253, 248, 201, 0.08);
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .toc-item a {
    color: #cbd5e1;
    text-decoration: none;
    display: inline-flex;
    gap: 0.4rem;
    transition: color 0.15s, text-shadow 0.15s;
  }

  .toc-item a:hover {
    color: var(--accent-color, rgb(253, 248, 201));
    text-shadow: 0 0 8px rgba(253, 248, 201, 0.4);
  }

  .toc-num {
    color: #71717a;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 1280px) {
    .wiki-toc {
      max-width: 100%;
    }
  }
</style>