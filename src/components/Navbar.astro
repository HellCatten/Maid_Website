---
// src/components/Navbar.astro
// Здесь пишется серверный JS/TS код. В браузере его не будет.
const links = [
  { name: 'Главная', url: '/' },
  { name: 'Новости', url: '/news' },
  { name: 'Вики', url: '/wiki' },
];
---

<nav class="navbar">
  <div class="flexbox">
    <div class="logo">
      <a href="/">
        <img src="/src/assets/logo_yellow_crop_64h.png" class="logo-img">
      </a>
    </div>
    <ul class="nav-links">
      {links.map((link) => (
        <li><a href={link.url} class="link">{link.name}</a></li>
      ))}
    </ul>
  </div>
</nav>

<style>
  /* Стили здесь локальные (Scoped). Они применятся только к этому Navbar */
  .navbar {
    /*max-width:1280px; */
    width: fit-content;
    margin-top: 8px;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    align-items: center;
    padding: 0.5rem 2rem;
    background-color: rgb(36, 36, 36);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 32px;
    transition:
      width 1s,
      border-left 0.5s,
      border-right 0.5s,
      border-radius 2s;
  }
  @media(width < 1280px) {
    .navbar {
      width: 100%;
      margin-left: auto;
      margin-right: auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 2rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      border-right: 1px solid rgba(255, 255, 255, 0);
      border-left: 1px solid rgba(255, 255, 255, 0);
      border-radius: 0;
    }
  }
  .flexbox {
    display: flex;
    flex-direction: row;
    gap: 5rem;
  }

  .logo-img {
    height:64px;
    width: 91px;
  }

  .nav-links {
    display: flex;
    gap: 3rem;
    list-style: none;
    justify-content: center;
    align-items: center;
  }

  .nav-links a:hover {
    color: var(--accent-color);
    text-shadow: 2px 2px 8px var(--accent-color-bg);
  }
  .link {
    font-weight: 400;
    font-size: 1.2rem;
  }
</style>