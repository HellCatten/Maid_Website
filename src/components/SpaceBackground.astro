---
// src/components/SpaceBackground.astro
---

<div class="space-viewport">
  <!-- Цветные туманности (CSS) -->
  <div class="nebula nebula-yellow"></div>
  <div class="nebula nebula-purple"></div>

  <!-- Холст для процедурной генерации случайных звезд -->
  <canvas id="space-canvas"></canvas>
</div>

<script is:inline>
  (function initSpace() {
    const canvas = document.getElementById('space-canvas');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    // Палитра звезд: базовые белые, акцентные фиолетовые и теплые желтые
    const starColors = [
      '#ffffff', 
      '#ffffff', 
      '#ffffff', 
      '#ffd166', // янтарно-желтый
      '#c084fc'  // космический фиолетовый
    ];

    // Генерируем 140 случайных звезд
    const starCount = Math.floor((width * height) / 9000);
    const stars = Array.from({ length: Math.max(80, starCount) }, () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      radius: Math.random() * 1.6 + 0.4,
      color: starColors[Math.floor(Math.random() * starColors.length)],
      alpha: Math.random() * 0.7 + 0.3,
      speed: Math.random() * 0.02 + 0.005,
      factor: Math.random() * Math.PI * 2
    }));

    let animationFrameId;

    function render() {
      ctx.clearRect(0, 0, width, height);

      for (let star of stars) {
        star.factor += star.speed;
        // Эффект мерцания звезд
        const currentAlpha = star.alpha + Math.sin(star.factor) * 0.25;

        ctx.beginPath();
        ctx.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
        ctx.fillStyle = star.color;
        ctx.globalAlpha = Math.max(0.1, Math.min(1, currentAlpha));
        ctx.fill();
      }

      animationFrameId = requestAnimationFrame(render);
    }

    render();

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });
  })();
</script>

<style>
  .space-viewport {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    /* КРИТИЧНО: -1 гарантирует, что фон уйдет НАЗАД за Navbar, контент и Footer */
    z-index: -1; 
    pointer-events: none;
    background-color: #0e0f12;
    overflow: hidden;
  }

  #space-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Размытые туманности */
  .nebula {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.22;
    pointer-events: none;
  }

  /* Желтая туманность в правом верхнем углу */
  .nebula-yellow {
    width: 550px;
    height: 450px;
    top: -100px;
    right: -50px;
    background: radial-gradient(circle, #ff9d42 0%, rgba(255, 157, 66, 0) 70%);
  }

  /* Фиолетовая туманность в левой нижней части */
  .nebula-purple {
    width: 600px;
    height: 500px;
    bottom: -150px;
    left: -100px;
    background: radial-gradient(circle, #8b5cf6 0%, rgba(139, 92, 246, 0) 70%);
  }
</style>