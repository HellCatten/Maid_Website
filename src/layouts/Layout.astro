---
// src/layouts/BaseLayout.astro
import '../styles/global.css'; // Подключаем глобальные стили
import Navbar from '../components/Navbar.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = "Maid — Ламповый сервер Space Station 14",
  description = "Maid Station — ролевой сервер Space Station 14 с динамичными сменами, отзывчивой администрацией и ламповым коммьюнити. Присоединяйтесь к нам!",
  image = "/og-banner.png", // Картинка для превью в Discord/TG (1200x630 в папке public)
  type = "website"
} = Astro.props;

// Автоматически формируем абсолютный канонический URL текущей страницы
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://maidstation.ru');
const imageURL = new URL(image, Astro.site || 'https://maidstation.ru');

// Склеиваем красивый тег <title> (например: "Вики | Maid SS14")
const fullTitle = title.includes('Maid') ? title : `${title} | Maid SS14`;

// JSON-LD микроразметка для Google и Яндекса
const schemaData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Maid Station SS14",
  "url": "https://maidstation.ru",
  "description": description
};
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <!-- Базовые технические теги -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Векторная адаптивная фавиконка для современных браузеров -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">

    <link rel="icon" href="/favicon.ico" sizes="32x32">

    <!-- Для экранов Apple (iPhone / iPad) -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Цвет темы браузера (на смартфонах окрашивает верхнюю плашку в неон/черный) -->
    <meta name="theme-color" content="#ff9d42" />

    <!-- Канонический URL (защита от дублей страниц) -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Основные поисковые мета-теги -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="keywords" content="Space Station 14, SS14, Maid Station, сервер SS14, космическая станция 14, вики SS14, Мейд, Мэйд, SS14 roleplay" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Discord / Telegram / VK / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:site_name" content="Maid Station" />
    <meta property="og:locale" content="ru_RU" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Микроразметка Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body>
    <Navbar /> <!-- Навбар будет на всех страницах, использующих этот Layout -->
    
    <main class="container">
      <slot /> <!-- Сюда попадет контент из файлов в папке pages -->
    </main>

    <footer>
      <!-- Тут можно добавить футер -->
      <p>© 2026 Maid</p>
    </footer>
  </body>
</html>

<style>
  .container {
    width: 80%;
    margin: 0 auto;
    min-height: 80vh;
    padding: 1rem 0 1rem 0;
  }
  footer {
    text-align: center;
    padding: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  @media(width < 1280px) {
    .container {
      width: 100%;
      padding: 1rem;
    }
  }
</style>

<style is:global>
  /* 1. Всегда резервируем трек скролла на ВСЕХ страницах (Главная, Вики, Новости).
        Ширина экрана теперь строго одинаковая везде — сдвиг навбара вправо физически невозможен! */
  html {
    overflow-y: scroll;
    /* Тонкий аккуратный скроллбар для Firefox */
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }

  /* 2. Кастомный скроллбар под стиль Maid для Chrome, Edge, Safari */
  html::-webkit-scrollbar {
    width: 8px; /* Компактная ширина вместо стандартных громоздких 17px */
  }

  /* Прозрачный трек: когда скроллить нечего, он абсолютно незаметен и не оставляет дыр */
  html::-webkit-scrollbar-track {
    background: transparent;
  }

  /* Сам бегунок (полупрозрачный) */
  html::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    border: 2px solid transparent;
    background-clip: padding-box;
  }

  /* При наведении подсвечиваем фирменным неоновым оранжевым */
  html::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 157, 66, 0.6);
  }
</style>