<script>
  // Логика копирования: копирует содержимое ВМЕСТЕ с <br> (innerHTML),
  // чтобы при вставке в SS14 разметка не ломалась
  document.addEventListener('DOMContentLoaded', () => {
    const copyButtons = document.querySelectorAll('.copy-btn');

    copyButtons.forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const targetBtn = btn as HTMLButtonElement;
        const textElement = targetBtn.parentElement?.querySelector('.doc-text');
        if (!textElement) return;

        // Получаем чистый HTML с сохранением всех тегов <br>
        const content = textElement.innerText;
        const originalText = targetBtn.innerText;

        try {
          await navigator.clipboard.writeText(content);
          targetBtn.innerText = '✓ Скопировано!';
          targetBtn.classList.add('copied');
        } catch (err) {
          console.error('Ошибка копирования:', err);
          targetBtn.innerText = 'Ошибка';
        }

        setTimeout(() => {
          targetBtn.innerText = originalText;
          targetBtn.classList.remove('copied');
        }, 2000);
      });
    });
  });
</script>

