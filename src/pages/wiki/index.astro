---
// src/pages/wiki/index.astro
import BaseLayout from '../../layouts/Layout.astro';
import SpaceBackground from '../../components/SpaceBackground.astro';
import ServerConnect from '../../components/ServerConnect.jsx';

const wikiModules = import.meta.glob('./*.astro', { eager: true });
const iconFiles = import.meta.glob<{ default: ImageMetadata }>('/src/content/wiki/icons/*.png', { eager: true });

function getIconUrl(iconName: string): string {
  const match = Object.entries(iconFiles).find(([path]) => path.endsWith(iconName));
  // @ts-ignore
  return match ? match[1].default.src || match[1].default : '';
}

const wikiMeta: Record<string, { title: string; icon: string; desc: string }> = {
  begginersguide: { 
    title: 'Для новых космонавтов', 
    icon: 'forbeginners_icon.png', 
    desc: 'Первые шаги на борту: управление, основы выживания и базовые советы.' 
  },
  howtoplay: { 
    title: 'Как играть', 
    icon: 'howtoplay.png', 
    desc: 'Интерфейс, хоткеи, взаимодействие с предметами и механики окружения.' 
  },
  rules: { 
    title: 'Правила сервера', 
    icon: 'rule_icon.png', 
    desc: 'Основные положения, правила поведения и ролевой отыгрыш.' 
  },
  spacelaw: { 
    title: 'Космический закон', 
    icon: 'space_law_icon.png', 
    desc: 'Правовой кодекс Nanotrasen: статьи, сроки заключения и регламенты СБ.' 
  },
  roles: { 
    title: 'Профессии и роли', 
    icon: 'roles_icon.png', 
    desc: 'От клоуна и ассистента до Главного Врача и Капитана станции.' 
  },
  guides: { 
    title: 'Гайды и инструкции', 
    icon: 'guides_icon.png', 
    desc: 'Настройка двигателей, атмосферные расчеты, хирургия и химия.' 
  },
  maps: { 
    title: 'Карты станций', 
    icon: 'maps_icon.png', 
    desc: 'Схемы отсеков, технические тоннели, эвакуационные маршруты.' 
  },
  gamemodes: { 
    title: 'Игровые режимы', 
    icon: 'gamemodes_icon.png', 
    desc: 'Предатели, Ядерные Оперативники, Зомби-апокалипсис и другие угрозы.' 
  },
  lore: { 
    title: 'История космоса', 
    icon: 'nt_icon.png', 
    desc: 'История космоса, Nanotrasen и всех событий.' 
  },
  homepage: { 
    title: 'Портал сообщества', 
    icon: 'homepage.png', 
    desc: 'Общая информация о проекте и полезные ссылки.' 
  }
};

const articles = Object.entries(wikiModules)
  .filter(([path]) => !path.endsWith('index.astro'))
  .map(([path, mod]: [string, any]) => {
    const slug = path.split('/').pop()?.replace('.astro', '') || '';
    const meta = wikiMeta[slug] || {};
    const iconFile = mod.icon || meta.icon || 'homepage.png';

    return {
      url: `/wiki/${slug}`,
      title: mod.title || meta.title || slug.toUpperCase(),
      iconSrc: getIconUrl(iconFile),
      desc: mod.desc || meta.desc || 'Статья базы знаний.'
    };
  });
---

<BaseLayout title="База знаний — Space Station 14">
  <SpaceBackground />

  <div class="wiki-container">
    <!-- Вводный блок об игре в стиле терминала станции -->
    <header class="terminal-card">
      <div class="terminal-header">
        <div class="terminal-controls">
          <span class="control red"></span>
          <span class="control yellow"></span>
          <span class="control green"></span>
        </div>
        <div class="terminal-title">NT_OS // DATABASE_ARCHIVE // <h1>ВИКИ</h1></div>
        <div class="terminal-badge">ONLINE</div>
      </div>

      <div class="terminal-body">
        <div class="briefing-heading">
          О <span class="neon-text">Space Station 14</span>
        </div>
        <p class="briefing-text">
          <strong>Space Station 14</strong> — это ролевая игра, вдохновлённая культовой классикой Space Station 13. Она наполнена паранойей, действие которой происходит в смертельной металлической ловушке, ловко маскирующейся под космическую станцию. С первого взгляда игра может показаться сложной из-за глубоких механик и взаимодействия с экипажем. Наша база знаний поможет быстро освоиться на борту.
        </p>

        <!-- Блок подключения к серверу -->
        <ServerConnect client:load />

        <div class="briefing-welcome">
          <span class="pulse-icon">✦</span>
          <span>Добро пожаловать в команду, космонавт!</span>
        </div>
      </div>
    </header>

    <!-- Сетка статей -->
    <main class="wiki-grid-section">
      <div class="section-title-bar">
        <h2>Разделы документации</h2>
        <span class="articles-count">Файлов: {articles.length}</span>
      </div>

      <div class="articles-grid">
        {articles.map((item) => (
          <a href={item.url} class="wiki-card">
            <div class="card-icon-wrapper">
              {item.iconSrc ? (
                <img 
                  src={item.iconSrc} 
                  alt={item.title} 
                  class="wiki-pixel-icon" 
                  loading="lazy"
                />
              ) : (
                <span class="icon-fallback">📄</span>
              )}
            </div>
            
            <div class="card-text">
              <h3 class="card-title">{item.title}</h3>
              <p class="card-desc">{item.desc}</p>
            </div>

            <div class="card-arrow">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .wiki-container {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .terminal-card {
    background: rgba(22, 23, 26, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 157, 66, 0.25);
    border-radius: 12px;
    box-shadow: 0 0 25px rgba(255, 157, 66, 0.08), 0 15px 30px rgba(0, 0, 0, 0.5);
    overflow: hidden;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    background: rgba(0, 0, 0, 0.4);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .terminal-controls {
    display: flex;
    gap: 6px;
  }

  .control {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .control.red { background: #ff5f56; }
  .control.yellow { background: #ffbd2e; }
  .control.green { background: #27c93f; }

  .terminal-title {
    font-family: monospace;
    font-size: 0.8rem;
    color: #949ba4;
    letter-spacing: 0.1em;
    padding: 0 1rem;
  }

  .terminal-title h1 {
    display: inline;
    font-family: monospace;
    font-size: 0.8rem;
    color: #949ba4;
    letter-spacing: 0.1em;
    font-weight: lighter;
  }

  .terminal-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: #4ade80;
    background: rgba(74, 222, 128, 0.12);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(74, 222, 128, 0.3);
  }

  .terminal-body {
    padding: 2rem 2.25rem;
  }

  .briefing-heading {
    margin: 0 0 1rem 0;
    font-size: 2rem;
    color: #ffffff;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .neon-text {
    color: #ff9d42;
    text-shadow: 0 0 16px rgba(255, 157, 66, 0.4);
  }

  .briefing-text {
    color: #c4c9d0;
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0;
  }

  .briefing-welcome {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1.2rem;
    background: rgba(255, 157, 66, 0.1);
    border: 1px solid rgba(255, 157, 66, 0.25);
    border-radius: 8px;
    color: #ffb46e;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .pulse-icon {
    color: #ff9d42;
    animation: spinSlow 8s linear infinite;
  }

  @keyframes spinSlow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Сетка карточек */
  .section-title-bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
  }

  .section-title-bar h2 {
    color: #ffffff;
    font-size: 1.5rem;
    margin: 0;
  }

  .articles-count {
    font-size: 0.85rem;
    color: #80848e;
    font-family: monospace;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
  }

  .wiki-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem;
    background: rgba(30, 31, 34, 0.7);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .wiki-card:hover {
    transform: translateY(-3px);
    background: rgba(35, 37, 41, 0.9);
    border-color: rgba(255, 157, 66, 0.4);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4), 0 0 15px rgba(255, 157, 66, 0.15);
  }

  .card-icon-wrapper {
    width: 52px;
    height: 52px;
    min-width: 52px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .wiki-pixel-icon {
    width: 36px;
    height: 36px;
    object-fit: contain;
    image-rendering: pixelated;
  }

  .card-text {
    flex: 1;
    min-width: 0;
  }

  .card-title {
    margin: 0 0 0.35rem 0;
    color: #f2f3f5;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .wiki-card:hover .card-title {
    color: #ff9d42;
  }

  .card-desc {
    margin: 0;
    color: #949ba4;
    font-size: 0.85rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-arrow {
    color: #4e5058;
    transition: all 0.2s ease;
  }

  .wiki-card:hover .card-arrow {
    color: #ff9d42;
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .terminal-body {
      padding: 1.5rem 1.25rem;
    }
    
    .briefing-heading {
      font-size: 1.6rem;
    }

    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>