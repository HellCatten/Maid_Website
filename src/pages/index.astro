---
// src/pages/index.astro
import BaseLayout from '../layouts/Layout.astro';
import Changelog from '../components/Changelog.jsx';
import ServerStatus from '../components/ServerStatus.jsx';
import NewsFeed from '../components/NewsFeed.astro';
import { NEWS_CHANNEL, BOOSTY_URL, DISCORD_URL, GITHUB_URL } from '../constants.js';

import fs from 'node:fs';
import { load } from 'js-yaml';

interface ChangeItem {
  type: string;
  message: string;
}

interface ChangelogEntry {
  id: number;
  author: string;
  time: string;
  changes: ChangeItem[];
}

interface ChangelogFile {
  Entries: ChangelogEntry[];
}

let initialEntries: ChangelogEntry[] = [];

try {
  const fileContents = fs.readFileSync('src/data/changelog.yml', 'utf8');
  const parsed = load(fileContents) as ChangelogFile;
  
  if (parsed && parsed.Entries) {
    initialEntries = parsed.Entries
      .sort((a, b) => new Date(b.time).getTime() - new Date(a.time).getTime())
      .slice(0, 10); 
  }
} catch (e) {
  console.warn("Ошибка при чтении changelog.yml");
}
---

<BaseLayout title="Главная">
  <!-- Главный блок: Левая колонка (контент) + Правая колонка (компоненты) -->
  <div class="main-grid">
    
    <!-- Левая колонка: Баннер, инфо, социальные кнопки -->
    <div class="hero-box" id="hero-box">
      <div>
        <div class="banner-wrapper">
          <img 
            src="/src/assets/banner_optimized.gif" 
            alt="Maid Cafe Banner" 
            class="banner-img"
          />
        </div>

        <div class="hero-text-content">
          <h1 class="hero-title">
            <span class="brand-accent">Maid</span> — тот самый ламповый сервер с хорошим коммьюнити, который вы искали.
          </h1>
          <p class="hero-subtitle">
            Уютная атмосфера, отзывчивая администрация и регулярные обновления. Присоединяйтесь к нашей космической станции прямо сейчас!
          </p>
        </div>
      </div>

      <!-- Единый блок кнопок: Discord | Boosty | GitHub -->
      <div class="community-button-group">
        <a 
          href={DISCORD_URL} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="group-btn btn-discord"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.093.252-.19.372-.287a.075.075 0 0 1 .077-.01c3.931 1.793 8.18 1.793 12.061 0a.075.075 0 0 1 .078.009c.12.098.246.195.373.288a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.89.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
          </svg>
          <span>Discord</span>
        </a>

        <div class="divider"></div>

        <a 
          href={BOOSTY_URL} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="group-btn btn-boosty"
        >
          <!-- Boosty Flame / Icon -->
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
            <path d="M12 2c-4.42 3.58-8 7.61-8 12a8 8 0 0 0 16 0c0-4.39-3.58-8.42-8-12zm0 18a6 6 0 0 1-6-6c0-3.1 2.5-6.2 6-9.5 3.5 3.3 6 6.4 6 9.5a6 6 0 0 1-6 6z"/>
            <path d="M12 9c-2 2-3 4-3 5.5a3 3 0 0 0 6 0c0-1.5-1-3.5-3-5.5z"/>
          </svg>
          <span>Boosty</span>
        </a>

        <div class="divider"></div>

        <a 
          href={GITHUB_URL} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="group-btn btn-github"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </div>

    <!-- Правая колонка: React-компоненты -->
    <div class="components-column" id="components-column">
      <ServerStatus client:load />
      <Changelog initialEntries={initialEntries} client:load />
    </div>
    
  </div>
  
  <!-- Секция свежих новостей -->
  <section class="home-news-section">
    <div class="news-section-header">
      <div class="header-titles">
        <div class="news-badge">
          <span class="pulse-dot"></span>
          Лента событий
        </div>
        <h2 class="section-title">Новости сообщества</h2>
      </div>
      
      <div class="header-actions">
        <a 
          href={NEWS_CHANNEL} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-discord-alt"
        >
          В Discord
        </a>

        <a href="/news" class="btn btn-all-news">
          Все новости →
        </a>
      </div>
    </div>
  
    <div class="news-list-wrapper">
      <NewsFeed limit={5} />
    </div>

    <div class="bottom-more">
      <a href="/news" class="more-link">
        Перейти в архив всех новостей →
      </a>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  function syncHeights() {
    const hero = document.getElementById('hero-box');
    const column = document.getElementById('components-column');

    console.log('[Sync Layout] Поиск элементов:', { hero, column });

    if (!hero || !column) {
      console.warn('[Sync Layout] Элементы не найдены в DOM!');
      return;
    }

    if (window.innerWidth > 1024) {
      const heroHeight = hero.offsetHeight;
      column.style.height = heroHeight + 'px';
      console.log(`[Sync Layout] Высота установлена: ${heroHeight}px`);
    } else {
      column.style.height = 'auto';
    }
  }

  // 1. Запуск сразу при чтении документа
  syncHeights();

  // 2. Запуск после полной загрузки страницы и картинок/гифок
  window.addEventListener('load', syncHeights);

  // 3. Запуск при изменении размера окна
  window.addEventListener('resize', syncHeights);

  // 4. Поддержка View Transitions (если используются в Astro)
  document.addEventListener('astro:page-load', syncHeights);

  // 5. Авто-отслеживание через ResizeObserver (когда догрузился баннер)
  const heroElement = document.getElementById('hero-box');
  if (heroElement && window.ResizeObserver) {
    new ResizeObserver(() => {
      syncHeights();
    }).observe(heroElement);
  }
</script>

<style>
  /* Сетка верхнего блока: 2 колонки */
  .main-grid {
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
    margin-top: 1.5rem;
    align-items: flex-start;
  }

  /* Левый блок (Hero) */
  .hero-box {
    flex: 1;
    min-width: 0; /* предотвращает переполнение flex-элементов */
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .banner-wrapper {
    width: 100%;
    overflow: hidden;
  }

  .banner-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .hero-text-content {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 1.25rem;
  }

  .hero-title {
    margin: 0;
    font-size: 1.45rem;
    line-height: 1.4;
    font-weight: 600;
    color: #e3e5e8;
  }

  .brand-accent {
    color: var(--accent-color); /* Неоновый теплый оттенок вывески Maid Cafe */
    font-weight: 800;
    text-shadow: 2px 2px 8px var(--accent-color-bg);
  }

  .hero-subtitle {
    margin: 0.6rem 0 0;
    color: #949ba4;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Единая плашка кнопок <discord | boosty | github> */
  .community-button-group {
    display: flex;
    align-items: center;
    background: #1e1f22;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    overflow: hidden;
    width: 100%;
  }

  .group-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    color: #b5bac1;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.2s ease;
    background: transparent;
  }

  .group-btn:hover {
    color: #ffffff;
  }

  /* Разделители между кнопками */
  .divider {
    width: 1px;
    height: 24px;
    background: rgba(255, 255, 255, 0.1);
  }

  /* Индивидуальная подсветка при наведении */
  .btn-discord:hover {
    background: #5865f2;
  }

  .btn-boosty:hover {
    background: #f15f2c;
  }

  .btn-github:hover {
    background: #2b2d31;
    color: #ffffff;
  }

  /* Правая колонка с компонентами */
  .components-column {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 380px; /* фиксированная базовая ширина для статус-бара и чейнджлога */
    flex-shrink: 0;
  }

  /* Секция новостей */
  .home-news-section {
    width: 100%;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .news-section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .news-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--accent-color);
    background: rgba(255, 157, 66, 0.12);
    padding: 0.25rem 0.6rem;
    border-radius: 20px;
    margin-bottom: 0.5rem;
    border: 1px solid rgba(255, 157, 66, 0.25);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-color-bg);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--accent-color-bg);
  }

  .section-title {
    margin: 0;
    font-size: 1.85rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.2;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-discord-alt {
    background: #2b2d31;
    color: #dbdee1;
    border: 1px solid #35373c;
  }

  .btn-discord-alt:hover {
    background: #5865f2;
    color: #ffffff;
    border-color: #5865f2;
  }

  .btn-all-news {
    background: #5865f2;
    color: #ffffff;
  }

  .btn-all-news:hover {
    background: #4752c4;
  }

  .news-list-wrapper {
    width: 100%;
  }

  .bottom-more {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .more-link {
    color: #949ba4;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .more-link:hover {
    color: #5865f2;
    background: rgba(88, 101, 242, 0.08);
  }

  /* Адаптив под планшеты и мобилки */
  @media (max-width: 1280px) {
    .main-grid {
      flex-direction: column;
    }
    
    .components-column {
      width: 100%; /* на планшетах и мобилках компоненты растягиваются во всю ширину */
      height: auto !important;
    }
  }

  @media (max-width: 640px) {
    .community-button-group {
      flex-direction: column;
    }
    
    .divider {
      width: 100%;
      height: 1px;
    }

    .news-section-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .header-actions {
      width: 100%;
    }

    .btn {
      flex: 1;
      justify-content: center;
    }
  }
</style>