---
// src/pages/index.astro
import BaseLayout from '../layouts/Layout.astro';
import Changelog from '../components/Changelog.jsx';
import ServerStatus from '../components/ServerStatus.jsx';
import NewsFeed from '../components/NewsFeed.astro';
import { NEWS_CHANNEL } from '../constants.js';

import fs from 'node:fs';
import { load } from 'js-yaml';

interface ChangeItem {
  type: string;
  message: string;
}

interface ChangelogEntry {
  id: number;
  author: string;
  time: string;
  changes: ChangeItem[];
}

interface ChangelogFile {
  Entries: ChangelogEntry[];
}

let initialEntries: ChangelogEntry[] = [];

try {
  const fileContents = fs.readFileSync('src/data/changelog.yml', 'utf8');
  const parsed = load(fileContents) as ChangelogFile;
  
  if (parsed && parsed.Entries) {
    // Берем только первые 10 для первичной загрузки!
    initialEntries = parsed.Entries
      .sort((a, b) => new Date(b.time).getTime() - new Date(a.time).getTime())
      .slice(0, 10); 
  }
} catch (e) {
  console.warn("Ошибка при чтении changelog.yml");
}

---

<BaseLayout title="Главная">
  <div class="homepage-content">
    
    <!-- Основной контент главной страницы -->
    <section class="hero">
      <h1>Добро пожаловать на проект!</h1>
      <p>Тут какой-то текст, баннеры, кнопки.</p>
    </section>

    <!-- React компоненты -->
    <aside class="sidebar">
      <ServerStatus client:load />
      <Changelog initialEntries={initialEntries} client:load />
    </aside>
    
  </div>
  
  <!-- Секция свежих новостей -->
  <section class="home-news-section">
    <div class="news-section-header">
      <div class="header-titles">
        <div class="news-badge">
          <span class="pulse-dot"></span>
          Лента событий
        </div>
        <h2 class="section-title">Новости сообщества</h2>
      </div>
      
      <!-- Кнопки перехода -->
      <div class="header-actions">
        <a 
          href={NEWS_CHANNEL} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-discord"
          title="Открыть канал в приложении или браузере"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.093.252-.19.372-.287a.075.075 0 0 1 .077-.01c3.931 1.793 8.18 1.793 12.061 0a.075.075 0 0 1 .078.009c.12.098.246.195.373.288a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.89.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
          </svg>
          В Discord
        </a>

        <a href="/news" class="btn btn-all-news">
          Все новости
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  
    <!-- Выводим максимум 5 последних новостей -->
    <div class="news-list-wrapper">
      <NewsFeed limit={5} />
    </div>

    <!-- Дополнительная ссылка внизу списка -->
    <div class="bottom-more">
      <a href="/news" class="more-link">
        Перейти в архив всех новостей →
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .homepage-content {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 1rem;
  }

  .hero {
    flex: 1;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Секция новостей */
  .home-news-section {
    width: 100%;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .news-section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .news-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #5865f2;
    background: rgba(88, 101, 242, 0.12);
    padding: 0.25rem 0.6rem;
    border-radius: 20px;
    margin-bottom: 0.5rem;
    border: 1px solid rgba(88, 101, 242, 0.25);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    background: #5865f2;
    border-radius: 50%;
    box-shadow: 0 0 8px #5865f2;
  }

  .section-title {
    margin: 0;
    font-size: 1.85rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.2;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-discord {
    background: #2b2d31;
    color: #dbdee1;
    border: 1px solid #35373c;
  }

  .btn-discord:hover {
    background: #5865f2;
    color: #ffffff;
    border-color: #5865f2;
  }

  .btn-all-news {
    background: #5865f2;
    color: #ffffff;
  }

  .btn-all-news:hover {
    background: #4752c4;
  }

  .news-list-wrapper {
    width: 100%;
  }

  .bottom-more {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .more-link {
    color: #949ba4;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .more-link:hover {
    color: #5865f2;
    background: rgba(88, 101, 242, 0.08);
  }

  @media (max-width: 1024px) {
    .homepage-content {
      flex-direction: column;
    }
    .sidebar {
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .news-section-header {
      flex-direction: column;
      align-items: flex-start;
    }
    .header-actions {
      width: 100%;
    }
    .btn {
      flex: 1;
      justify-content: center;
    }
  }
</style>