---
// src/pages/index.astro
import BaseLayout from '../layouts/Layout.astro';
import Changelog from '../components/Changelog.jsx';
import ServerStatus from '../components/ServerStatus.jsx';
import NewsFeed from '../components/NewsFeed.astro';

import fs from 'node:fs';
import { load } from 'js-yaml';

interface ChangeItem {
  type: string;
  message: string;
}

interface ChangelogEntry {
  id: number;
  author: string;
  time: string;
  changes: ChangeItem[];
}

interface ChangelogFile {
  Entries: ChangelogEntry[];
}

let initialEntries: ChangelogEntry[] = [];

try {
  const fileContents = fs.readFileSync('src/data/changelog.yml', 'utf8');
  const parsed = load(fileContents) as ChangelogFile;
  
  if (parsed && parsed.Entries) {
    // Берем только первые 10 для первичной загрузки!
    initialEntries = parsed.Entries
      .sort((a, b) => new Date(b.time).getTime() - new Date(a.time).getTime())
      .slice(0, 10); 
  }
} catch (e) {
  console.warn("Ошибка при чтении changelog.yml");
}
---

<BaseLayout title="Главная">
  <div class="homepage-content">
    
    <!-- Основной контент главной страницы -->
    <section class="hero">
      <h1>Добро пожаловать на проект!</h1>
      <p>Тут какой-то текст, баннеры, кнопки.</p>
    </section>

    <!-- Наш React компонент Changelog -->
    <!-- client:idle загрузит JS для него, когда браузер будет свободен -->
    <aside class="sidebar">
      <Changelog initialEntries={initialEntries} client:load />
      <ServerStatus client:load />
    </aside>
    
  </div>
  
  <section style="width: 100%;">
      <h2>Новости сообщества</h2>
  
      <div style="width: 100%;">
        <NewsFeed />
      </div>
    </section>
</BaseLayout>


<style>
  .homepage-content {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 2rem;
  }

  .hero {
    flex: 1; /* Занимает оставшееся пространство */
  }

  /* Если экран маленький, блок спрыгнет вниз */
  @media (max-width: 1024px) {
    .homepage-content {
      flex-direction: column;
    }
  }
</style>